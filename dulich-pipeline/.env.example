# ── AI ───────────────────────────────────────────────────────────────────────
# Viết kịch bản + title album (DeepSeek/GPT qua OpenRouter)
OPENROUTER_KEY=sk-or-your-key
# Whisper đọc voice → phụ đề khớp giọng (BẮT BUỘC cho phụ đề chính xác)
OPENAI_API_KEY=sk-your-openai-key

# ── Giọng đọc ────────────────────────────────────────────────────────────────
VBEE_API_KEY=your-vbee-key
VBEE_APP_ID=your-vbee-app-id
API_VIVIBE_KEY=your-vivibe-key
VIVIBE_API_URL=https://api.lucylab.io/json-rpc
VIVIBE_VOICE_THU_REVIEW_ID=orBfJ4Q68FyVbckjJgDvkj
VIVIBE_VOICE_TRINH_REVIEW_ID=uCMfUVPwStduZMyFC7iuQv
VIVIBE_VOICE_MY_REVIEW_ID=vcXEe1p3FxPfpswf3BhwbG
VIVIBE_VOICE_ADAM_3_ID=5r2MVjMfzwsSDzTpaLjbY9
# Các request dùng chung API key sẽ chờ lần lượt, không fallback sai giọng.
VIVIBE_LOCK_TIMEOUT_SECONDS=900
# Nếu có export ngoài app đang chạy, giữ lượt và thử lại trong tối đa 180 giây.
VIVIBE_BUSY_RETRY_SECONDS=180
VOICE_PROVIDER=vbee          # gtts | vbee | vivibe | edge | chirp | mock

# ── Tin tức ──────────────────────────────────────────────────────────────────
APIFY_KEY_VIETCHINH=apify_api_your-key
ENABLE_GEMINI_AI_IMAGE=0

# ── Đăng bài ─────────────────────────────────────────────────────────────────
ZERNIO_KEY=sk-your-zernio-key
ZERNIO_API_BASE_URL=https://zernio.com/api/v1
# BẮT BUỘC khi deploy để đăng TikTok: URL công khai (Zernio phải tải được video)
PUBLIC_BASE_URL=https://your-domain.com

# ── Bảo mật web ───────────────────────────────────────────────────────────────
# Origin chính xác của SPA/API (không có dấu / cuối).
APP_ORIGIN=https://your-domain.com
# Chuỗi ngẫu nhiên tối thiểu 32 ký tự, chỉ lưu trong .env production.
MEDIA_SIGNING_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# Production HTTPS luôn bật; local HTTP có thể đặt 0.
AUTH_COOKIE_SECURE=1
# Phiên: 12 giờ không hoạt động, tối đa 7 ngày.
SESSION_IDLE_SECONDS=43200
SESSION_ABSOLUTE_SECONDS=604800

# ── Hàng đợi + upload nhiều người ──────────────────────────────────────────
# Mỗi tài khoản được giữ chỗ/upload/xếp tối đa 4 job; render nặng vẫn tuần tự.
MAX_ACTIVE_JOBS_PER_USER=4
# Tối đa 5 nhân viên × 4 job để tránh đầy disk khi cùng gửi file lớn.
MAX_GLOBAL_ACTIVE_JOBS=20
# Giới hạn file, tổng một phiên upload và số phiên upload song song/tài khoản.
MAX_UPLOAD_FILE_MB=500
MAX_UPLOAD_JOB_MB=1536
MAX_UPLOAD_SESSIONS_PER_USER=4
# Frontend gửi chunk 8 MB; server cho phép tối đa 16 MB.
MAX_UPLOAD_CHUNK_MB=16
# VPS production nên giữ ít nhất 15 GB trống cho output và file tạm.
UPLOAD_DISK_RESERVE_MB=15360
# Endpoint multipart cũ chỉ để tương thích; web mới luôn dùng chunk.
MAX_LEGACY_MULTIPART_MB=64
# Production chạy worker.py bằng service riêng và tắt worker trong web server.
DISABLE_JOB_WORKER=1
HEAVY_JOB_WORKERS=1
NETWORK_JOB_WORKERS=2
# Worker cha dừng cả cây FFmpeg nếu job vượt giới hạn này.
HEAVY_JOB_TIMEOUT_SECONDS=1800
NETWORK_JOB_TIMEOUT_SECONDS=180
WORKER_HEALTH_MAX_AGE_SECONDS=35
# Dọn upload mỗi giờ; 04:00 archive output cũ lên Drive rồi mới xóa local.
MAINTENANCE_INTERVAL_SECONDS=3600
MAINTENANCE_HOUR=4
UPLOAD_SESSION_TTL_HOURS=24
OUTPUT_RETENTION_DAYS=5
# Chờ tối đa 45 giây để Zernio xác nhận; sau đó scheduler đối soát theo giờ.
ZERNIO_CONFIRM_SECONDS=45
PUBLISH_RECONCILE_BATCH=20

# ── Lưu trữ (deploy VPS, tùy chọn) ──────────────────────────────────────────
# Service Account không có quota My Drive riêng: dùng folder thuộc Shared Drive,
# hoặc chọn oauth và token.json của một tài khoản người dùng.
GOOGLE_DRIVE_AUTH_MODE=service_account
GOOGLE_SERVICE_ACCOUNT_PATH=/opt/CreatorAppDuLich/secrets/drive-service-account.json
GOOGLE_DRIVE_FOLDER_ID=your-shared-drive-folder-id
GOOGLE_DRIVE_SHARED_DRIVE_ID=your-shared-drive-id
# Archive/backup mặc định riêng tư. Chỉ bật nếu thực sự muốn anyone-with-link.
GOOGLE_DRIVE_MAKE_PUBLIC=0
# Supabase — lưu record nội dung (tùy chọn)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-key
