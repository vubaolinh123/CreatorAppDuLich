# ── AI ───────────────────────────────────────────────────────────────────────
# Viết kịch bản + title album (DeepSeek/GPT qua OpenRouter)
OPENROUTER_KEY=sk-or-your-key
# Whisper đọc voice → phụ đề khớp giọng (BẮT BUỘC cho phụ đề chính xác)
OPENAI_API_KEY=sk-your-openai-key

# ── Giọng đọc ────────────────────────────────────────────────────────────────
VBEE_API_KEY=your-vbee-key
VBEE_APP_ID=1313e91f-727b-4770-824c-34174534d7a0
VOICE_PROVIDER=vbee          # vbee | mock (thiếu key → tự fallback Edge free)

# ── Tin tức ──────────────────────────────────────────────────────────────────
APIFY_API_KEY=apify_api_your-key

# ── Đăng bài ─────────────────────────────────────────────────────────────────
ZERNIO_KEY=sk-your-zernio-key
# BẮT BUỘC khi deploy để đăng TikTok: URL công khai (Zernio phải tải được video)
PUBLIC_BASE_URL=https://your-domain.com

# ── Lưu trữ (deploy VPS, tùy chọn) ──────────────────────────────────────────
# Google Drive Service Account — backup output trước khi xóa local (5 ngày)
GOOGLE_SERVICE_ACCOUNT_PATH=credentials.json
GOOGLE_DRIVE_FOLDER_ID=
# Supabase — lưu record nội dung (tùy chọn)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-key
