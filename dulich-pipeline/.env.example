# ── AI Models ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-key

# ── Voice Providers ───────────────────────────────────────────────────────────
# Primary: Vbee.ai (tiếng Việt native)
VBEE_API_KEY=your-vbee-key
VOICE_PROVIDER=vbee          # vbee | elevenlabs | mock

# Secondary: ElevenLabs (bilingual / voice clone)
ELEVENLABS_API_KEY=your-elevenlabs-key

# ── Creator Voice IDs ─────────────────────────────────────────────────────────
# Vbee.ai built-in voice codes (no key needed for standard voices)
CREATOR1_VOICE_ID=hn_female_lananh     # Lan Anh — Vbee.ai Hà Nội nữ
CREATOR2_VOICE_ID=hn_male_minhtuan     # Minh Tuấn — Vbee.ai Hà Nội nam
CREATOR3_VOICE_ID=                     # Thu Hà — ElevenLabs (Instant Clone ID)
CREATOR4_VOICE_ID=hcm_male_ducanh      # Đức Anh — Vbee.ai HCM nam
CREATOR5_VOICE_ID=hn_female_ngocmai    # Ngọc Mai — Vbee.ai Hà Nội nữ

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-key

# ── Google Drive ─────────────────────────────────────────────────────────────
# Chọn 1 trong 2 cách:
# Cách 1: Service Account (khuyên dùng cho server)
GOOGLE_SERVICE_ACCOUNT_PATH=credentials.json

# Cách 2: OAuth2 (cần token.json)
# GOOGLE_CLIENT_ID=your-client-id
# GOOGLE_CLIENT_SECRET=your-client-secret
# GOOGLE_REDIRECT_URI=http://localhost:7788/callback

# Folder ID trên Google Drive để lưu video (để trống sẽ tự tạo)
GOOGLE_DRIVE_FOLDER_ID=

# ── Social Publishing ─────────────────────────────────────────────────────────
# TikTok API
TIKTOK_ACCESS_TOKEN=your-tiktok-access-token

# Facebook API
FACEBOOK_ACCESS_TOKEN=your-facebook-access-token
FACEBOOK_PAGE_ID=your-facebook-page-id

# ── Dashboard ─────────────────────────────────────────────────────────────────
DASHBOARD_URL=http://localhost:3000

# ── Resource Config ───────────────────────────────────────────────────────────
MAX_WORKERS=2          # Số jobs chạy song song
RAM_GB=4.0             # RAM tối đa (GB)
CPU_CORES=2            # Số CPU cores
