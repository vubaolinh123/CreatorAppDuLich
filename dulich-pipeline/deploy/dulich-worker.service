[Unit]
Description=Da Lat Studio durable render/publish worker
After=network.target dulich.service

[Service]
Type=simple
User=dulich
WorkingDirectory=/opt/CreatorAppDuLich/dulich-pipeline
ExecStart=/opt/CreatorAppDuLich/dulich-pipeline/.venv/bin/python -X utf8 worker.py --queue all
Restart=always
RestartSec=5
KillMode=control-group
TimeoutStopSec=15
UMask=0077
Environment=PYTHONUTF8=1
Environment=PYTHONIOENCODING=utf-8

[Install]
WantedBy=multi-user.target
