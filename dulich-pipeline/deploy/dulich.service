[Unit]
Description=Da Lat Studio (dulich-pipeline)
After=network.target

[Service]
Type=simple
User=dulich
WorkingDirectory=/opt/CreatorAppDuLich/dulich-pipeline
ExecStart=/opt/CreatorAppDuLich/dulich-pipeline/.venv/bin/python -X utf8 server.py
Restart=always
RestartSec=5
Environment=PYTHONUTF8=1
Environment=PYTHONIOENCODING=utf-8

[Install]
WantedBy=multi-user.target
