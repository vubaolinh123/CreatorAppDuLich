[Unit]
Description=Da Lat Studio SQLite backup
After=network-online.target

[Service]
Type=oneshot
User=dulich
WorkingDirectory=/opt/CreatorAppDuLich/dulich-pipeline
ExecStart=/opt/CreatorAppDuLich/dulich-pipeline/.venv/bin/python -X utf8 tools/backup_sqlite.py --upload-drive
UMask=0077
Environment=PYTHONUTF8=1
Environment=PYTHONIOENCODING=utf-8
