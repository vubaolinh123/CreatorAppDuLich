# Sao chép file này thành `.env` rồi điền key thật. `.env` đã được gitignore — KHÔNG commit.

# OpenAI (text/image)
OPENAI_API_KEY=

# OpenRouter (dùng cho AI viết kịch bản — model openai/gpt-4o-mini)
OPENROUTER_KEY=

# Vbee TTS (giọng tiếng Việt) — app_id + token. Lấy ở https://api.vbee.vn
VBEE_APP_ID=
VBEE_API_KEY=

# Vivibe TTS — API key từ tài khoản Vivibe, Voice ID có thể thay đổi qua env
API_VIVIBE_KEY=
VIVIBE_API_URL=https://api.lucylab.io/json-rpc
VIVIBE_VOICE_THU_REVIEW_ID=orBfJ4Q68FyVbckjJgDvkj
VIVIBE_VOICE_TRINH_REVIEW_ID=uCMfUVPwStduZMyFC7iuQv
VIVIBE_VOICE_MY_REVIEW_ID=vcXEe1p3FxPfpswf3BhwbG
VIVIBE_VOICE_ADAM_3_ID=5r2MVjMfzwsSDzTpaLjbY9

# Voice provider mặc định: gtts | vbee | vivibe | edge | chirp
VOICE_PROVIDER=gtts

# Apify dùng chung cho toàn app
APIFY_KEY_VIETCHINH=

# Tính năng tạo lại ảnh TikTok bằng Gemini đang tạm dừng
ENABLE_GEMINI_AI_IMAGE=0


